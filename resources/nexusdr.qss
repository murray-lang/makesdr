QMainWindow {
    background-color: #061922;
}
QChartView {
    background-color: #061922;
}

#chartTheme {
    qproperty-textColor: "white";
    qproperty-backgroundColor: "#061922";
    qproperty-plotAreaColor: "#061922";
    qproperty-seriesLineColor: "#0c394c";
    qproperty-seriesAreaColor: "#00952d";
    qproperty-gridColor: "#0c394c";
    qproperty-cursorALineColor: "#ca1c00";
    qproperty-cursorAAreaColor: "#80791d0e";
    qproperty-cursorBLineColor: "#ca6B00";
    qproperty-cursorBAreaColor: "#8079470e";
}

QToolBar#toolBar {
    background-color: #061922;
    qproperty-iconSize: 48px 48px;
}

QToolBar#toolBar QToolButton {
    color: palette(window-text);
    border-radius: 0px;
    qproperty-iconSize: 48px 48px;
    min-width: 70px;
    max-width: 70px;
    font-size: 24px;
    font-weight: bold;
}

QtNumericKeypad {
    background-color: #061922;
}

QtNumericKeypad QPushButton {
    background-color: #065a7f;
}

QtNumericKeypad QLineEdit {
    background-color: #065a7f;
    font-weight: bold;
}

QtStepper {
    background-color: #061922;
    border: 1px solid #061922;
}

QtStepper QToolButton {
    background-color: #0c394c;
    border: 1px solid #0c394c;
}

QtStepper QToolButton:pressed {
    background-color: #0384bc;
    border: 1px solid #0384bc;
}

QToolButton.toolbarButton {
    background-color: #065a7f;
    border-width: 1px;
    border-style: solid;
    border-top-color: #0384bc;
    border-left-color: #0384bc;
    border-bottom-color: #0c394c;
    border-right-color: #0c394c;
    margin-right: 10px;
}

QToolButton.toolbarConfigButton {

}

/* The added selector here lets it override ToolBar#toolBar QToolButton. */
QToolBar#toolBar QToolButton.toolbarKeypadButton {
    min-width: 50px;
    max-width: 50px;
    qproperty-iconSize: 32px 32px;
}

QToolButton.toolbarConfigButton:pressed {
    background-color: #0384bc;
    border: 1px solid #0384bc;
}

QToolButton.toolbarBandButton {

}

QToolButton.toolbarBandButton:pressed {
    background-color: #0384bc;
    border: 1px solid #0384bc;
}

QToolButton.toolbarModeButton {

}

QToolButton.toolbarModeButton:pressed {
    background-color: #0384bc;
    border: 1px solid #0384bc;
}

QToolButton.toolbarAgcButton {

}

QToolButton.toolbarAgcButton:pressed {
    background-color: #0384bc;
    border: 1px solid #0384bc;
}

QToolButton.toolbarLevelsButton {
 
}

QToolButton.toolbarLevelsButton:pressed {
    background-color: #0384bc;
    border: 1px solid #0384bc;
}

QMenu.toolbarMenu {
    font-size: 16px;
    font-weight: bold;

    background-color: #0384bc;
    border: 1px solid #0384bc;
}

QMenu.toolbarMenu::item:selected {
    font-style: italic;
}

QMenu.toolbarMenu::item:checked {
    font-size: 18px;
}

QMenu.toolbarMenu::item:checked:selected {
    font-size: 18px;
}

QMenu.toolbarMenu::item:selected {
    background-color: #0c394c;
    color: white;
}


/* Style items for any menu with the 'toolbarMenu' class */
QMenu.toolbarMenu::item {
    padding: 10px 30px;
    color: black;
}



.toolbarDialog {
    background-color: #ff061922;
    opacity: 1;
}

.toolbarDialogTabs {
    background-color: #ff0384bc;
    opacity: 1;
}

.toolbarDialogTabs QTabBar::tab {
    background-color: #065a7f;
    opacity: 1;
    font-weight: bold;
}

.toolbarDialogTabs QTabBar::tab:selected {
    background-color: #ff0384bc;
    opacity: 1;
}
/*
.toolbarDialogTabs::pane {
    background-color: red;
    opacity: 1;
}
*/

.toolbarDialogTab {
    opacity: 1;
}

QPushButton.toolbarDialogButton {
    background-color: #061922;
    opacity: 1;
    color: white;
}

QPushButton.toolbarDialogButton[selected=true] {
    background-color: #0384bc;
    opacity: 1;
    color: black;
}
