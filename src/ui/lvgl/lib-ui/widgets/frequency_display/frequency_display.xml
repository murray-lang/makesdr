<widget>
	<previews>
		<preview width="480" height="272" style_bg_color="0xeee" />
	</previews>

	<api>
		<prop name="frequency" type="int" help="Radio frequency in Hz." />
	</api>

	<styles>
		<style name="style_base" bg_opa="100%" bg_color="0x000000" text_color="0x0dacf1" />
		<style name="left_text" text_align="left" align="bottom_right" />
		<style name="right_text" text_align="right" align="bottom_left" />
	</styles>

	<view extends="lv_obj" width="165" height="35">
		<style name="style_base" />
		<row width="100%" gap="0" vertical_align="end">
			<h3 name="khz" width="120" text="00000">
				<style name="right_text" />
			</h3>
			<h4 name="hz" text="000">
				<style name="left_text" />
			</h4>
		</row>
	</view>
</widget>
