<widget>
	<previews>
		<preview width="480" height="272" style_bg_color="0xeee" />
	</previews>

	<api>
		<prop name="bins" type="image" default="0" help="Spectrum bins as bytes" />
	</api>

	<styles>
		<style name="style_base" bg_opa="100%" bg_color="0x6080e0" />
	</styles>

	<view extends="lv_obj" width="100%" height="100%">
		<style name="style_base" />

		<lv_chart
			name="panadapter_chart"
			width="100%"
			height="100%"
			type="line"
			point_count="255"
			hor_div_line_count="0"
			ver_div_line_count="0"
			style_bg_color="0x0c394c"
		>
			<lv_chart-axis axis="primary_y" min_value="0" max_value="255" />
			<lv_chart-series color="0x22f2f2" axis="primary_y" values="0" />
		</lv_chart>
	</view>
</widget>
